<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>RYZORA</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="bg"></div>

<div class="card">

  <!-- BOT LOGO -->
  <img 
    src="https://cdn.discordapp.com/app-icons/YOUR_BOT_ID/YOUR_ICON.png"
    class="logo"
  >

  <h1>RYZORA</h1>

  <p class="desc">
    Professional Discord moderation and utility bot.
  </p>

  <% if (!user) { %>

    <!-- LOGIN BUTTON -->
    <a class="login-btn" href="/auth/discord">
      Login with Discord
    </a>

  <% } else { %>

    <!-- USER INFO -->
    <img 
      src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
      class="avatar"
    >

    <h2><%= user.username %></h2>

    <!-- INVITE BUTTON -->
    <a class="invite-btn"
      href="https://discord.com/oauth2/authorize?client_id=1489882067239047168&permissions=8&scope=bot">
      Invite Ryzora
    </a>

    <a class="logout" href="/logout">
      Logout
    </a>

  <% } %>

</div>

</body>
</html>
