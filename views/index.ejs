<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ryzora</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="card">

  <img 
  src="https://cdn.discordapp.com/embed/avatars/0.png"
  class="logo">

  <h1>Ryzora</h1>

  <% if (user) { %>

    <img
    src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
    class="avatar">

    <h2><%= user.username %></h2>

    <a
    class="invite-btn"
    href="https://discord.com/oauth2/authorize?client_id=1489882067239047168&permissions=8&scope=bot"
    target="_blank">
    Invite Bot
    </a>

    <a class="logout" href="/logout">
    Logout
    </a>

  <% } else { %>

    <a class="login-btn" href="/login">
    Login With Discord
    </a>

  <% } %>

</div>

</body>
</html>
